rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: portfolio
// Document ID: {market}_{ticker} (e.g., TW_2308, US_RKLB)
// Fields:
//   - market: string (required, immutable, enum: 'TW' | 'US') - Market identifier
//   - ticker: string (required, immutable, 1..15 chars, uppercase alphanumeric/.-) - Stock ticker
//   - yf_symbol: string (required, 1..20 chars, valid Yahoo Finance symbol) - Yahoo Finance ticker
//   - name: string (required, 1..100 chars) - Stock display name
//   - avg_cost: number (required, 0..100000000) - Average holding cost
//   - focus: string (optional, 0..200 chars) - Key investment thesis or catalyst focus
//
// Collection: reports
// Document ID: {YYYY-MM-DD}_{market} (e.g., 2026-11-19_TW)
// Access Pattern: Written exclusively by Python backend (main.py) via Firebase Admin SDK.
//                 Client web app (index.html) has read-only access for authorized admin.
//
// Collection: afterhours_reports
// Document ID: {YYYY-MM-DD}_{market} (e.g., 2026-11-24_TW)
// Access Pattern: Written exclusively by Python backend (main.py --mode afterhours) via Admin SDK.
//                 Client web app (index.html) has read-only access for authorized admin.
// Fields:
//   - date: string (YYYY-MM-DD, Asia/Taipei)
//   - market: string ('TW' | 'US')
//   - market_summary: string
//   - stocks: list of maps (closing price, candle pattern, intraday review, next_day_strategy, support/resistance)
//   - updated_at: timestamp
//
// Collection: stock_events
// Document ID: {market}_{ticker}_{event_type}_{YYYY-MM-DD}
// Access Pattern: Populated by Python backend (main.py --mode events) via Admin SDK;
//                 authorized admin may also read, create/update manual events, or delete events.
// Fields (client manual writes):
//   - market: string (required, immutable, enum: 'TW' | 'US' | 'MACRO')
//   - ticker: string (required, immutable, 1..15 chars)
//   - name: string (required, 1..100 chars)
//   - event_type: string (required, immutable, enum: 'conference' | 'earnings' | 'dividend' | 'fomc' | 'other')
//   - event_date: string (required, YYYY-MM-DD)
//   - title: string (required, 1..150 chars)
//   - summary: string (optional, 0..1000 chars)
//   - source: string (required, enum: 'manual')
//   - updated_at: timestamp (optional)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user matches a specific UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Restrict access strictly to the bootstrapped admin UID or server-assigned admin custom claim.
    // This prevents unauthorized access even if someone registers a new account via public sign-up.
    function isAdmin() {
      return isOwner('wBEHwFAGi3TpY6C0BimjRgDTfe92') ||
        (isAuthenticated() && request.auth.token.get('admin', false) == true);
    }

    // Verify UID hasn't been tampered with on create (if present)
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure UID field is not modified on update (if present)
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string length bounds
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string field (if present, must be string within bounds)
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // Validate that immutable fields have not changed on update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validate portfolio stock document schema, types, size limits, and ID consistency
    function isValidPortfolioStock(stockId) {
      let data = request.resource.data;
      let allowedFields = ['market', 'ticker', 'yf_symbol', 'name', 'avg_cost', 'focus'];
      let requiredFields = ['market', 'ticker', 'yf_symbol', 'name', 'avg_cost'];

      return hasOnlyAllowedFields(allowedFields) &&
        hasRequiredFields(requiredFields) &&
        data.market in ['TW', 'US'] &&
        validStringLength('ticker', 1, 15) &&
        data.ticker.matches('^[A-Z0-9][A-Z0-9.-]{0,14}$') &&
        stockId == data.market + '_' + data.ticker &&
        validStringLength('yf_symbol', 1, 20) &&
        (
          (data.market == 'TW' && data.yf_symbol.matches('^[A-Z0-9-]+\\.TWO?$')) ||
          (data.market == 'US' && data.yf_symbol.matches('^[A-Z0-9][A-Z0-9.-]{0,19}$'))
        ) &&
        validStringLength('name', 1, 100) &&
        data.avg_cost is number &&
        data.avg_cost >= 0 &&
        data.avg_cost <= 100000000 &&
        isValidOptionalString('focus', 0, 200);
    }

    // Validate client-authored manual stock event document
    function isValidManualStockEvent(eventId) {
      let data = request.resource.data;
      let allowedFields = ['market', 'ticker', 'name', 'event_type', 'event_date', 'title', 'summary', 'source', 'updated_at'];
      let requiredFields = ['market', 'ticker', 'name', 'event_type', 'event_date', 'title', 'source'];

      return hasOnlyAllowedFields(allowedFields) &&
        hasRequiredFields(requiredFields) &&
        data.market in ['TW', 'US', 'MACRO'] &&
        validStringLength('ticker', 1, 15) &&
        data.ticker.matches('^[A-Z0-9][A-Z0-9.-]{0,14}$') &&
        validStringLength('name', 1, 100) &&
        data.event_type in ['conference', 'earnings', 'dividend', 'fomc', 'other'] &&
        data.event_date is string &&
        data.event_date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        eventId == data.market + '_' + data.ticker + '_' + data.event_type + '_' + data.event_date &&
        validStringLength('title', 1, 150) &&
        isValidOptionalString('summary', 0, 1000) &&
        data.source == 'manual' &&
        (!('updated_at' in data) || data.updated_at is timestamp);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Portfolio holdings: managed exclusively by authorized admin
    match /portfolio/{stockId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && uidUnchanged() && isValidPortfolioStock(stockId);
      allow update: if isAdmin() &&
        uidNotModified() &&
        isValidPortfolioStock(stockId) &&
        areImmutableFieldsUnchanged(['market', 'ticker']);
      allow delete: if isAdmin();
    }

    // Daily AI premarket reports: read-only for authorized admin.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Daily AI after-hours closing reports: read-only for authorized admin.
    match /afterhours_reports/{reportId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Stock corporate events calendar (conference, earnings, dividend):
    // Read/delete by admin; backend writes via Admin SDK; admin may also add manual events.
    match /stock_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && uidUnchanged() && isValidManualStockEvent(eventId);
      allow update: if isAdmin() &&
        uidNotModified() &&
        isValidManualStockEvent(eventId) &&
        areImmutableFieldsUnchanged(['market', 'ticker', 'event_type']);
      allow delete: if isAdmin();
    }

    // Default deny for all other collections and subcollections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}