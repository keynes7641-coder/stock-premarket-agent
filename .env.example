# Google AI Studio API Key (必填)
GEMINI_API_KEY=your_gemini_api_key

# Finnhub API Key (美股新聞用，未填則依賴 Google Search Grounding)
FINNHUB_API_KEY=your_finnhub_api_key

# Firebase Service Account 完整 JSON 字串，或本地 JSON 金鑰檔案路徑 (必填)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# 選用：Telegram 盤前摘要推播
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_URL=https://your-username.github.io/your-repo/
